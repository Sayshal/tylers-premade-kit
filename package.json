{
  "name": "tylers-premade-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node dev/tools/setup-links.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "stylelint \"**/*.css\" --fix",
    "validate": "npm run lint && npm run format:check && npm run stylelint",
    "build": "rollup -c rollup.config.mjs",
    "build:watch": "rollup -c rollup.config.mjs --watch",
    "dev": "rollup -c rollup.config.mjs --environment BUILD:development",
    "clean": "node -e \"import('fs').then(f=>f.rmSync('dist',{recursive:true,force:true}))\"",
    "prebuild": "npm run clean && npm run build:db",
    "build:clean": "node ./utils/packs.mjs package clean",
    "build:db": "node ./utils/packs.mjs package pack",
    "build:json": "node ./utils/packs.mjs package unpack",
    "build:source": "node ./utils/packs.mjs package unpack",
    "compile": "npm run build:db",
    "extract": "npm run build:source"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@foundryvtt/foundryvtt-cli": "^1.0.0-rc.4",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "fancy-log": "^2.0.0",
    "globals": "^15.15.0",
    "js-yaml": "^4.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "yargs": "^17.7.2"
  }
}
